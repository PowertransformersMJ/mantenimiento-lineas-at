#!/bin/sh
# ===========================================================
# 🧠 pre-commit — guardián determinista del cerebro
# ===========================================================
# Corre brain:check cuando el commit toca CLAUDE.md o docs/ y BLOQUEA
# el commit si el cerebro tiene problemas. Convierte el Reflejo de
# Auto-auditoría (CLAUDE.md §G.4) de doctrina-que-debo-recordar a
# garantía determinista (M-10: lo verificable va al linter que falla).
#
# Activar (una vez):  git config core.hooksPath githooks
# Saltar (intencional): git commit --no-verify
# ===========================================================
# macOS: las GUIs de git traen PATH mínimo — añadir homebrew/nvm para hallar node
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
for d in "$HOME"/.nvm/versions/node/*/bin; do [ -d "$d" ] && PATH="$d:$PATH"; done

# ═══════════════════════════════════════════════════════════════
# 🛰️  EXPORTACIONES DE SCADA — se reconocen por su CONTENIDO, no por su nombre
# ═══════════════════════════════════════════════════════════════
# ⚠️ POR QUÉ POR CONTENIDO. El `.gitignore` protege una RUTA —«Variables
# Electricas/»— y el Ingeniero va a ir dejando ahí los días según los exporte.
# El día que la carpeta se llame «Datos SCADA», o «Variables Eléctricas» con
# tilde, o «enero», la protección desaparece **en silencio** y el archivo entra
# en el commit sin que nada chille. Se probó: con otro nombre, git los ve.
#
# El 07-09 esto ya estuvo a punto de pasar: siete exportaciones de la RED ENTERA
# quedaron en el índice y las paró de rebote el guardián de COORDENADAS, que no
# está para eso (`33 · L-07`, tercera cara).
#
# Lo que se busca es la FIRMA del formato, que no depende del nombre:
#   · el marcador de valor momentáneo que lleva CADA fila — `/MvMoment`
#   · la etiqueta de un punto con su nivel de tensión — `/ALGO /66kV /`
#   · o la fila de sellos de tiempo que abre el archivo — `,1/01/26 0:00,`
#
# ⚠️ El primero es el que de verdad muerde: el nivel de tensión NO está en todas
# las filas —`/PT007 /SubB/R-0000 /I R /MvMoment` no lo trae— y buscarlo solo a
# él dejaba pasar archivos enteros. (Etiqueta INVENTADA: aquí entró un rótulo
# REAL de su exportación y sobrevivió tres días, porque no era el nombre de una
# subestación y la lista de la bóveda solo miraba esos — `33 · L-07`, 4ª cara.)
#
# Se miran solo los archivos AÑADIDOS o MODIFICADOS, y solo su cabeza.
scada=""
# ⚠️ EL SEPARADOR ES EL SALTO DE LÍNEA, NO EL ESPACIO. Su carpeta se llama
# «Variables Electricas» —con espacio—, así que un `for` con el separador de
# siempre la partía en dos trozos, ninguno existía como archivo, y el guardián
# no miraba NADA. Falló contra el único caso para el que se escribió, y se vio
# porque se probó de verdad en vez de darlo por bueno. `quotepath=false` es lo
# que evita que una tilde llegue escapada y pase lo mismo.
IFS_ORIG=$IFS
IFS='
'
for f in $(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM); do
  # ⚠️ SOLO ARCHIVOS DE DATOS. El primer intento miraba TODO y se cazó a sí
  # mismo —este guardián lleva la marca escrita— y al núcleo, que la documenta.
  # Un guardián que grita sin razón se acaba apagando con `--no-verify`, y eso
  # apaga todos los demás de golpe (`§ADR-095`). Una exportación siempre llega
  # como `.csv` o `.xls`: eso es lo que se mira.
  case "$f" in
    *.csv|*.CSV|*.tsv|*.TSV|*.txt|*.TXT|*.dat|*.DAT|*.xls|*.XLS|*.xlsx|*.XLSX|*.xlsm) : ;;
    *) continue ;;
  esac
  case "$f" in
    tests/fixtures/*) continue ;;             # el sintético vive AQUÍ, y ninguno casa la firma (medido 10-09)
  esac
  [ -f "$f" ] || continue
  if head -c 200000 "$f" 2>/dev/null \
     | grep -qE '(/MvMoment)|(/[A-Za-z][A-Za-z0-9 ._-]*[[:space:]]*/[0-9]+(\.[0-9]+)?kV[[:space:]]*/)|(^,[0-9]{1,2}/[0-9]{2}/[0-9]{2} [0-9]{1,2}:[0-9]{2},)'; then
    scada="$scada
$f"
  fi
done
IFS=$IFS_ORIG
if [ -n "$scada" ]; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: esto parece una EXPORTACIÓN DE SCADA (dato de cliente)."
  echo "$scada" | sed '/^$/d' | while IFS= read -r f; do echo "   · $f"; done
  echo ""
  echo "   Este repositorio es PÚBLICO y la historia de git es permanente (33 · L-07)."
  echo "   Una exportación trae la red entera: subestaciones, bahías y su carga hora a hora."
  echo "   Su sitio es ../brain-private/mantenimiento-lineas-at/ — o una carpeta que el"
  echo "   .gitignore cubra. Este guardián mira el CONTENIDO, así que da igual cómo se llame."
  exit 1
fi

# ═══════════════════════════════════════════════════════════════
# 🏭 NOMBRES REALES DE SUBESTACIÓN — la lista vive en la BÓVEDA
# ═══════════════════════════════════════════════════════════════
# Se limpiaron una vez (`d44a602`) y volvieron a entrar solos en tres ADR
# seguidos al citar una etiqueta de señal de ejemplo. Una etiqueta de ejemplo se
# INVENTA: `/SubA`, `/SubB`.
#
# ⚠️ LA LISTA NO PUEDE ESTAR AQUÍ. El primer intento escribía los nombres en el
# propio patrón, y este archivo está en el repositorio PÚBLICO: el guardián se
# bloqueaba a sí mismo y, peor, publicaba justo lo que venía a proteger. El
# guardián es público —cómo se comprueba no es secreto—; la lista es privada.
#
# Si la bóveda no está montada, se AVISA y no se bloquea: un clon sin bóveda no
# puede quedar inservible, pero tampoco puede creerse protegido.
lista="$(dirname "$0")/../../brain-private/mantenimiento-lineas-at/nombres-que-no-salen.txt"
if [ -f "$lista" ]; then
  patron=$(grep -vE '^\s*(#|$)' "$lista" | paste -sd '|' -)
  if [ -n "$patron" ]; then
    sub=$(git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+' \
      | grep -niE "$patron" || true)
    if [ -n "$sub" ]; then
      echo ""
      echo "❌ COMMIT BLOQUEADO: nombre REAL de subestación en lo que se va a commitear."
      echo "$sub" | head -10
      echo ""
      echo "   Repositorio PÚBLICO (33 · L-07/L-23). En un ejemplo, el nombre se INVENTA:"
      echo "   /SubA, /SubB. Ya se limpiaron una vez y volvieron a entrar solos."
      exit 1
    fi
  fi
else
  echo "⚠️  bóveda no montada: no se comprobaron los nombres reales (99 §ADR-114)."
fi

# ═══════════════════════════════════════════════════════════════
# 🛰️  COORDENADAS REALES — este guardián corre SIEMPRE, no solo con el cerebro
# ═══════════════════════════════════════════════════════════════
# Este repositorio es PÚBLICO y la historia de git es permanente (`33 · L-07`).
# La comprobación existía desde julio… como un paso a mano en `docs/10`, y el
# 19-08 pasó lo que tenía que pasar: se ejecutó, se vio el resultado y el commit
# salió igual, con el centro real de la línea dentro de una prueba (`33 · L-23`,
# que ya decía que una coordenada real en una prueba es una fuga igual). Un
# guardián cuyo resultado no BLOQUEA no es un guardián, es un adorno.
#
# El patrón es el mismo que documenta `docs/10`: cuatro o más decimales en la
# franja de latitud/longitud del Caribe colombiano. Se miran solo las líneas
# AÑADIDAS y se excluyen los recortes del mapa, que son públicos por decisión.
#
# ⚠️ Y se excluye una cosa más, aprendida el 2026-09-02: **TODO DOI empieza por
# `10.`** — `10.3390/resources8020080` es un artículo citado, no una latitud de
# Barranquilla. Sin esta salvedad, el guardián bloqueaba cada vez que el cerebro
# citaba una fuente, y empujaba justo a lo peor: a saltárselo con `--no-verify`,
# que apaga TODOS los demás guardianes de una vez. Un guardián que grita sin
# razón se acaba apagando (`§ADR-095`).
#
# La distinción es exacta y no debilita nada: en un DOI, los dígitos van
# SIEMPRE seguidos de `/`; en una coordenada, jamás.
fugas=$(git diff --cached -U0 -- . ':(exclude)web/public/mapas/*' \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -nE '(10\.[0-9]{4,}|-7[45]\.[0-9]{4,})' \
  | grep -vE '(doi\.org/)?10\.[0-9]{4,}/')
if [ -n "$fugas" ]; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: parecen COORDENADAS REALES en lo que se va a commitear."
  echo "$fugas" | head -20
  echo ""
  echo "   Este repositorio es PÚBLICO y la historia de git es permanente (33 · L-07)."
  echo "   Una coordenada real dentro de una PRUEBA es una fuga igual que en el código (L-23)."
  echo "   Cámbialas por sintéticas (ecuador y meridiano de Greenwich) y vuelve a intentarlo."
  echo "   Si de verdad es un número que no es una coordenada: 'git commit --no-verify'."
  exit 1
fi

staged=$(git diff --cached --name-only)
# ═══════════════════════════════════════════════════════════════
# 🔢 LA VERSIÓN DEL MOTOR — se sube en el MISMO commit que lo cambia
# ═══════════════════════════════════════════════════════════════
# El sello que acompaña a cada tabla calculada imprime `@lineas/nucleo v0.x.y`, y
# ese número es lo que permite defender un informe tres años después: dos
# informes calculados con motores que juzgan distinto no pueden salir firmados
# con la misma versión. Estuvo congelado en 0.1.0 mientras entraban las acciones
# correctivas, las causas raíz en plural, la barrera de contención, cinco
# familias nuevas y la capacidad longitudinal: la trazabilidad convertida en
# adorno (`99 §ADR-051`).
#
# Cambio de comentario o de prueba: `git commit --no-verify`, a conciencia.
motor=$(git diff --cached --name-only -- nucleo/ | grep -v '^nucleo/package.json$' || true)
if [ -n "$motor" ]; then
  if ! git diff --cached -U0 -- nucleo/package.json | grep -qE '^\+.*"version"'; then
    echo ""
    echo "❌ COMMIT BLOQUEADO: cambia el MOTOR y su versión se queda igual."
    echo "$motor" | sed 's/^/   · /'
    echo ""
    echo "   El sello de cada tabla calculada imprime esa versión: si no sube, dos"
    echo "   informes con motores distintos salen firmados con el mismo número."
    echo "   Sube 'version' en nucleo/package.json, o usa --no-verify si el cambio"
    echo "   no toca el cálculo (un comentario, una prueba)."
    exit 1
  fi
fi


echo "$staged" | grep -qE '^(CLAUDE\.md|docs/)' || exit 0   # nada del cerebro staged → no aplica

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  pre-commit: 'node' no está en PATH → salto brain:check (commit permitido)."
  exit 0
fi

echo "🧠 brain:check (pre-commit)…"
if ! node scripts/brain-check.mjs; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: el cerebro tiene problemas (ver arriba)."
  echo "   Corrígelos, o usa 'git commit --no-verify' si es intencional."
  exit 1
fi

# 🔒 Candado del boot (TODO-28 #2, comité 2026-07-18): always-on > objetivo → NO pasa.
# Provisional instance-side; cuando el gate suba al kernel (condición §173 ×3) este bloque se BORRA.
if ! node scripts/boot-gate.mjs; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: presupuesto de boot excedido — poda antes de commitear."
  exit 1
fi
exit 0
