    "./csv": "./csv.js",
    "./gms": "./gms.js",
    "./procedencia": "./procedencia.js",
    "./package.json": "./package.json",
    "./mecanica": "./mecanica.js",
    "./bom": "./bom.js",
    "./informe": "./informe.js",
    "./informeRca": "./informeRca.js",
    "./gerencial": "./gerencial.js"
  },
  "dependencies": {
    "@lineas/nucleo": "*"
  },
  "sideEffects": false
}
